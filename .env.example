# SAKSHYA — environment variables. Copy to `api/.env` for local dev
# (pydantic-settings loads api/.env automatically; see api/app/config.py).
# Keep this file current whenever a new variable is introduced — CLAUDE.md's
# "Environment" section requires it.

# --- Database (Phase 1) -----------------------------------------------------
# Production: Supabase Postgres + PostGIS connection string.
# Local dev/test: point at api/docker-compose.yml's services instead
# (no Supabase credentials exist in this environment as of Phase 1) -
#   docker compose -f api/docker-compose.yml up -d
# Host port is 5434 (not 5432) because this dev machine already has a
# system Postgres bound to 5432 - adjust freely if yours is 5432.
DATABASE_URL=postgresql+psycopg2://sakshya:sakshya@localhost:5434/sakshya

# Used only by the pytest integration suite (tests/conftest.py), never by the
# running app itself. Points at the separate db_test service (port 5433) so
# test runs never touch dev data.
DATABASE_URL_TEST=postgresql+psycopg2://sakshya:sakshya@localhost:5433/sakshya_test

# --- App ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
ENV=development
CORS_ORIGINS=http://localhost:5173

# --- Photo storage (Phase 1: local disk; no object-storage service in the
# locked stack yet — swappable later with zero schema change since only a
# URL string is stored) ------------------------------------------------------
PHOTO_STORAGE_DIR=./app/static/photos
PHOTO_PUBLIC_BASE_URL=http://localhost:8000/static/photos

# --- Demo watershed config (PRD §14 — never hardcoded; swapping the real
# Marigaon boundary in later is a one-file change, zero code changes) --------
SEED_WATERSHED_CONFIG=scripts/config/watershed.yaml

# --- Phase 3 (GEE) — placeholders, unused by any Phase 1 code path ----------
GEE_SERVICE_ACCOUNT_KEY_PATH=
GEE_PROJECT_ID=

# --- Phase 2 (vision API) — placeholder, unused by any Phase 1 code path ----
VISION_API_KEY=
VISION_API_PROVIDER=

# --- Phase 5 (frontend) — see web/.env.example instead --------------------
# Vite only reads .env from web/, not this repo-root file. web/.env.example
# documents VITE_API_MODE (mock|live), VITE_API_BASE_URL, VITE_DEMO_MWS_ID.
