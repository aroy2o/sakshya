# SAKSHYA — environment variables. Copy to `api/.env` for local dev
# (pydantic-settings loads api/.env automatically; see api/app/config.py).
# Keep this file current whenever a new variable is introduced — CLAUDE.md's
# "Environment" section requires it.

# --- Database (Phase 1, switched Postgres+PostGIS -> MongoDB per explicit --
# human decision — see CLAUDE.md's "DB:" line and PRD.md §8's proposed
# rewrite) --------------------------------------------------------------------
# Production: a real MongoDB connection string (Atlas or otherwise) once one
# exists — none does in this environment.
# Local dev/test: point at api/docker-compose.yml's mongo service instead -
#   docker compose -f api/docker-compose.yml up -d
# Host port is 27018 (not 27017) because this dev machine already has a
# system mongod bound to 27017 - adjust freely if yours is 27017.
# No auth on the local container (Mongo's simplest default mode, fine for a
# localhost-only dev substitute) - add username:password@...&authSource=admin
# to the URI for a real/shared instance later, zero code change either way.
MONGO_URI=mongodb://localhost:27018/sakshya

# Used only by the pytest integration suite (tests/conftest.py), never by the
# running app itself. Same mongod, separate database, so test runs never
# touch dev data.
MONGO_URI_TEST=mongodb://localhost:27018/sakshya_test

# --- App ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
ENV=development
CORS_ORIGINS=http://localhost:5173

# --- Photo storage (Phase 1: local disk; no object-storage service in the
# locked stack yet — swappable later with zero schema change since only a
# URL string is stored) ------------------------------------------------------
PHOTO_STORAGE_DIR=./app/static/photos
PHOTO_PUBLIC_BASE_URL=http://localhost:8000/static/photos

# --- Demo watershed config (PRD §14 — never hardcoded; swapping the real
# Marigaon boundary in later is a one-file change, zero code changes) --------
SEED_WATERSHED_CONFIG=scripts/config/watershed.yaml

# --- Phase 3 (GEE precompute output, read-only from the API — FR3.3/FR3.4) --
# geospatial-engineer's scripts/precompute_gee.py writes here; the API only
# ever reads these files, never calls Earth Engine itself. Relative to the
# process's cwd, same convention as PHOTO_STORAGE_DIR (run the API from /api).
GEOSPATIAL_OUTPUT_DIR=../scripts/output
THEMATIC_PUBLIC_BASE_URL=http://localhost:8000/static/geospatial

# --- Reality Pass R3 (WDC-PMKSY registry output, read-only from the API) ----
# scripts/fetch_gt2.py writes here; GET /programme/marigaon only ever reads
# this file, never fetches wdcpmksy.dolr.gov.in itself (precompute-first,
# same rule as GEOSPATIAL_OUTPUT_DIR above).
REGISTRY_OUTPUT_DIR=../scripts/output/registry

# --- Reality Pass R5 (real-photo classifier benchmark, read-only from the API) -
# scripts/fetch_real_benchmark_photos.py + scripts/run_real_photo_benchmark.py
# write here; GET /classifier/benchmark only ever reads these files, never
# calls Wikimedia Commons or Ollama itself (precompute-first, same rule as
# REGISTRY_OUTPUT_DIR above).
REAL_PHOTOS_OUTPUT_DIR=../scripts/real_photos

# --- Phase 3 (GEE service account — used only by scripts/, never by the API) -
# Var name matches Earth Engine's own ADC convention (scripts/gee_client.py
# reads GOOGLE_APPLICATION_CREDENTIALS directly, not a SAKSHYA-specific name).
GOOGLE_APPLICATION_CREDENTIALS=
GEE_PROJECT_ID=

# --- Phase 2 (vision API) — placeholder, unused by any Phase 1 code path ----
VISION_API_KEY=
VISION_API_PROVIDER=

# The real default provider right now (api/app/services/vision.py) is a
# local Ollama model, read directly via os.environ by
# api/services/vision_providers/ollama_provider.py — not through
# app/config.py's Settings, so it's documented here rather than above.
# Undocumented until this line (found while wiring docker-compose.yml).
# Deliberately NOT set in the docker-compose.yml deploy (human decision,
# 2026-09-29): no real hosted vision provider is live yet, so
# POST /assets/{id}/classify fails per-request until one is wired in later
# — the app itself still starts and serves everything else fine either way.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=moondream

# --- Phase 5 (frontend) — see web/.env.example instead --------------------
# Vite only reads .env from web/, not this repo-root file. web/.env.example
# documents VITE_API_MODE (mock|live), VITE_API_BASE_URL, VITE_DEMO_MWS_ID.

# --- Single-server Docker Compose deploy (root docker-compose.yml) --------
# Values above stay as the *local-dev* defaults. For `docker compose up`,
# copy this file to .env at the repo root and adjust:
#   MONGO_URI          — ignored; docker-compose.yml hardcodes
#                         mongodb://mongo:27017/sakshya for the api service
#                         regardless of what's in .env, so the container
#                         always talks to its own mongo service.
#   CORS_ORIGINS        — set to the real public origin (nginx/web is the
#                         only thing the browser ever talks to directly).
#   PHOTO_PUBLIC_BASE_URL, THEMATIC_PUBLIC_BASE_URL — these are absolute
#                         URLs baked into JSON responses (not client-side
#                         composed like other API paths), so they must be
#                         the public origin + /api, e.g.
#                         https://your-domain/api/static/photos and
#                         https://your-domain/api/static/geospatial —
#                         nginx.conf strips the /api prefix before
#                         proxying to the api container.
#   GOOGLE_APPLICATION_CREDENTIALS, GEE_PROJECT_ID — leave blank; the live
#                         api container never calls Earth Engine
#                         (precompute-first non-negotiable, CLAUDE.md).
# WEB_PORT=8080          — host port nginx/web is published on (not read
#                         from this file's own var above; passed to
#                         docker-compose.yml's ${WEB_PORT:-8080} directly
#                         from the shell or a root .env).
