# SAKSHYA frontend (/web) — environment variables. Copy to web/.env for
# local dev. Vite only exposes vars prefixed VITE_ to client code, and only
# reads .env from this directory (not the repo-root .env.example, which is
# api/'s — see that file's own header).

# --- API mode -----------------------------------------------------------
# 'mock' (default if unset): runs entirely against src/mocks/fixtures/, no
#   backend needed — this is how Phase 5 was built (Round 1, before
#   backend-engineer's endpoints existed).
# 'live': calls the real FastAPI app via VITE_API_BASE_URL. Flip this at
#   Sync Point 1 per AGENTS.md — no component/hook code changes needed,
#   see src/api/index.ts.
VITE_API_MODE=mock

# Only read when VITE_API_MODE=live. Matches api/.env.example's
# API_HOST/API_PORT defaults (0.0.0.0:8000) and its CORS_ORIGINS, which
# already allows http://localhost:5173 (Vite's default dev port).
VITE_API_BASE_URL=http://localhost:8000

# --- Demo watershed (PRD §14 — config, not code) -------------------------
# Pins the dashboard to one MWS id. Leave unset to use the first result
# from GET /mws instead (see src/config.ts, src/App.tsx).
VITE_DEMO_MWS_ID=
